{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "yocare-live-registry",
  "main": "src/index.js",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yocare-live-registry",
      "database_id": "9ac3e964-ddf9-4ce1-bccb-be11a4136f2a",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
