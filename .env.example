# YouTube Data API v3 key. Restrict this key to the YouTube Data API
# and the exact production/preview HTTP referrers in Google Cloud Console.
VITE_YOUTUBE_API_KEY=

# Optional authorized movie/series playback resolver (HTTPS API endpoint).
# It must return { "rightsVerified": true, "playbackUrl": "https://..." } only for licensed streams.
# Defaults to /api/movies/playback when no resolver URL is configured.
VITE_YOCARE_MOVIE_PLAYBACK_API_URL=

# Optional browser handoff homepage (defaults to the configured source landing page).
VITE_YOCARE_BROWSER_HOME_URL=https://net77.cc/home

# Cloudflare Browser Run integration (set these on the website Worker, not in the frontend).
# CF_ACCOUNT_ID is a Worker variable; CF_BROWSER_RUN_TOKEN must be a Worker secret.
# BROWSER_ALLOWED_HOSTS is a comma-separated allowlist for the initial browser URL.
